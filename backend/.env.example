# ============================================================
# .env.example  —  이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요.
#   cp .env.example .env        (Windows PowerShell: copy .env.example .env)
#
# .env 는 .gitignore 에 등록되어 있어 절대 커밋되지 않습니다.
# 이 파일(.env.example)에는 실제 키를 절대 적지 마세요. 이름과 형식만 적습니다.
# ============================================================

# ------------------------------------------------------------
# 1) AI provider 선택   gemini | openai
#    개발 중에는 무료 티어인 gemini, 제출/시연 때는 openai 로 전환
# ------------------------------------------------------------
AI_PROVIDER=gemini

# Google AI Studio 에서 발급  https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Platform 에서 발급  https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI 응답 최대 토큰 (비용/쿼터 방어)
MAX_OUTPUT_TOKENS=500
AI_TEMPERATURE=0.7

# ------------------------------------------------------------
# 2) Firebase Firestore
#    아래 둘 중 하나만 설정하면 됩니다.
#
#    (A) 로컬 개발 — 서비스 계정 JSON 파일 경로
#        Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성
#        받은 json 파일을 backend/ 안에 두고 경로를 적으세요.
#
#    (B) Render 배포 — JSON 파일 전체 내용을 "한 줄 문자열"로 붙여넣기
#        파일을 메모장으로 열어 전체 복사 → 그대로 값에 붙여넣기
# ------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firestore 컬렉션 이름
DATA_COLLECTION=data
CONVERSATION_COLLECTION=conversations

# ------------------------------------------------------------
# 3) CORS — 프론트엔드가 접속해 올 주소 목록 (콤마로 구분)
#    로컬 개발용 + 배포 후 Vercel 도메인을 추가하세요.
# ------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ------------------------------------------------------------
# 4) 기타
# ------------------------------------------------------------
APP_ENV=local
